{
  "name": "skillooth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base /skillooth/",
    "preview": "vite preview",
    "scrape": "node scripts/scrape.mjs",
    "facts": "node scripts/build-item-facts.mjs",
    "names": "node scripts/build-item-names.mjs",
    "refresh": "node scripts/scrape.mjs && node scripts/build-item-names.mjs && node scripts/build-item-facts.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
